{
  "name": "pubsub-delay",
  "version": "1.0.0",
  "description": "Broker-agnostic message delay service using bucketed topics",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "test:unit": "node --import tsx --test test/unit/*.test.ts",
    "test:integration": "docker compose -f docker-compose.test.yml up --build --abort-on-container-exit --exit-code-from integration-test",
    "test:integration:down": "docker compose -f docker-compose.test.yml down -v",
    "docs:diagrams": "node scripts/generate-diagrams.mjs && node scripts/render-diagrams.mjs"
  },
  "dependencies": {
    "iso8601-duration": "^2.1.2",
    "kafkajs": "^2.2.4",
    "prom-client": "^15.1.3",
    "stompit": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
