      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "N = TIMEOUT_POOL_SIZE.  Kafka: ack = commit offset+1, nack = seek back to the offset.  ActiveMQ: nack = do not ack.",
